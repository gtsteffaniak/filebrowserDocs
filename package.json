{
  "name": "filebrowser-quantum-docs",
  "version": "1.0.0",
  "description": "FileBrowser Quantum Documentation",
  "type": "module",
  "scripts": {
    "translate": "node ./scripts/translations.js",
    "translate:check": "node ./scripts/translations.js --check",
    "translate:content": "node ./scripts/translations.js --mode=content",
    "translate:i18n": "node ./scripts/translations.js --mode=i18n",
    "doclinks:convert": "node ./scripts/doclinks.js",
    "doclinks:check": "node ./scripts/doclinks.js --check",
    "doclinks:validate-paths": "node ./scripts/check-doclink-paths.js",
    "doclinks:revert": "node ./scripts/doclinks.js --mode=revert",
    "changelog:link-format": "node ./scripts/changelog-link-format.js",
    "changelog:link-format:check": "node ./scripts/changelog-link-format.js --check",
    "frontmatter:check": "node ./scripts/check-frontmatter.js",
    "check:quick": "npm run frontmatter:check && npm run doclinks:check && npm run changelog:link-format:check",
    "check:all": "npm run check:quick && npm run translate:check && npm run doclinks:validate-paths"
  },
  "dependencies": {
    "deepl-node": "^1.12.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10"
  },
  "overrides": {
    "adm-zip": "^0.6.0"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=18.0.0"
  }
}
